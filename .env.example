# ==============================================================================
# RAG Generator configuration
#
# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real API keys.
#
# Switching LLM/embedding providers is a matter of uncommenting ONE block
# below (and commenting out the one you're replacing) — no code changes.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM provider — default: Anthropic (Claude)
# ------------------------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_API_KEY=your-anthropic-api-key
LLM_MODEL=claude-sonnet-4-5
# LLM_BASE_URL is not used for Anthropic — leave unset.
LLM_MAX_TOKENS=1024

# --- Groq (free tier, OpenAI-compatible) -------------------------------------
# LLM_PROVIDER=openai
# LLM_API_KEY=your-groq-api-key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- Google AI Studio (free tier, OpenAI-compatible endpoint) ----------------
# LLM_PROVIDER=openai
# LLM_API_KEY=your-google-ai-studio-api-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash

# --- Ollama (local, no API key) ----------------------------------------------
# LLM_PROVIDER=openai
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# --- OpenAI -------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_API_KEY=your-openai-api-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Embedding provider — default: local Hugging Face model, no API key, no
# network calls after the first download.
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- OpenAI-compatible embeddings (OpenAI, Google AI Studio, or Ollama) ------
# Use this if you'd rather not download a local model, or want to match an
# embedding model to whichever LLM provider you picked above.
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=your-api-key
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# Chunking / retrieval
# ------------------------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4

# ------------------------------------------------------------------------------
# Storage
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./chroma_db
UPLOAD_DIR=./uploads
